# Copy to .env.local and fill in. Never commit real values.
# Every variable here is server-only. Nothing in this app needs a NEXT_PUBLIC_ key:
# the browser talks only to our own routes, to signed Storage upload URLs, and
# follows redirects for Google sign-in.
#
# Google sign-in: the OAuth client ID and secret are pasted into the Supabase
# dashboard (Authentication -> Sign In / Providers -> Google). The app never reads them.

# OpenAI — read by @ai-sdk/openai by default
OPENAI_API_KEY=

# Supabase shared "lab" project, schema `papertrail`
SUPABASE_URL=
# sb_publishable_… (Settings -> API Keys). Used with the visitor's session cookie for auth.
SUPABASE_PUBLISHABLE_KEY=
# sb_secret_… — bypasses RLS; only for lib/db. Legacy anon/service_role keys stop working end of 2026.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=papertrail-documents

# Extraction
PAPERTRAIL_PRIMARY_MODEL=gpt-6-luna
PAPERTRAIL_ESCALATION_MODEL=gpt-6.1-sol
PAPERTRAIL_CONFIDENCE_THRESHOLD=0.85

# Max extraction runs per UTC day across all visitors: the budget guard. Counted
# from model_calls first attempts, so failed runs count too. Defaults to 50.
PAPERTRAIL_DAILY_EXTRACTION_CAP=50

# Uploads per signed-in user per UTC day (counted from Storage, so it holds even
# if a file is never registered). Defaults to 20.
PAPERTRAIL_DAILY_UPLOAD_CAP=20
